# Drasil local configuration
# Copy this file to backend/.env. Blank values disable optional integrations.

# AI strategist: codex-cli (default) or openai-api.
STRATEGIST_PROVIDER=codex-cli
CODEX_CLI_PATH=
STRATEGIST_CODEX_MODEL=
OPENAI_API_KEY=
STRATEGIST_OPENAI_MODEL=gpt-5-mini

# Browser origins allowed to call the API. Add comma-separated origins when
# serving more than one frontend. Do not use a wildcard with credentials.
DRASIL_FRONTEND_ORIGIN=http://localhost:5173
DRASIL_CORS_ORIGINS=

# Account registry and per-account private data. Defaults are already safe for
# local source installs; containers should mount these paths on persistent storage.
# DRASIL_AUTH_DATABASE_PATH=/absolute/path/to/drasil-auth.db
# DRASIL_ACCOUNT_DATA_ROOT=/absolute/path/to/accounts
# DRASIL_LEGACY_DATABASE_PATH=/absolute/path/to/old/drasil.db
DRASIL_SESSION_LIFETIME_SECONDS=2592000

# Required to create the first account from a remote browser. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DRASIL_BOOTSTRAP_TOKEN=

# Optional legacy/test database locations. Account databases normally live in
# DRASIL_ACCOUNT_DATA_ROOT and are always ignored by Git.
# DRASIL_DATABASE_PATH=/absolute/path/to/drasil.db
# STRATEGIST_CHECKPOINT_DB_PATH=/absolute/path/to/strategist-checkpoints.db

# Optional Google Calendar integration. Prefer a downloaded OAuth client file
# under backend/.secrets/ instead of copying credentials into this file.
GOOGLE_CALENDAR_CLIENT_JSON=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar-integrations/google/callback
GOOGLE_CALENDAR_TIME_ZONE=UTC
