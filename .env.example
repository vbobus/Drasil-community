# Copy to .env for Docker Compose. Never commit the copied .env file.

# The safe default exposes Drasil only to this machine. For a VPS behind a
# reverse proxy, leave this at 127.0.0.1 and proxy to port 8000 locally.
DRASIL_BIND_ADDRESS=127.0.0.1
DRASIL_PORT=8000

# Set a long random value before first-run setup on a remote backend.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(32))"
DRASIL_BOOTSTRAP_TOKEN=

# Browser origins permitted to use this backend. For a separate frontend,
# list its exact HTTPS origin (comma-separated for multiple frontends).
DRASIL_FRONTEND_ORIGIN=http://localhost:8000
DRASIL_CORS_ORIGINS=

# Optional server-wide defaults. Users can instead save their own provider
# and API key from Settings; those values are stored in their private account directory.
STRATEGIST_PROVIDER=codex-cli
# Vercel only: enable private account-scoped Codex Sandboxes.
# DRASIL_CODEX_SANDBOX=1
OPENAI_API_KEY=
STRATEGIST_OPENAI_MODEL=gpt-5-mini

# Optional agent observability. Aggregate mode excludes application content;
# full mode also exports prompts, responses, and tool payloads to Langfuse.
DRASIL_AGENT_OBSERVABILITY=auto
DRASIL_AGENT_OBSERVABILITY_CONTENT=aggregate
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0

# Google OAuth client settings are server-wide; each user's OAuth tokens are private.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar-integrations/google/callback
GOOGLE_CALENDAR_TIME_ZONE=UTC
